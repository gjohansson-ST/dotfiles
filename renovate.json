{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["before 2am"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies", "no-stale"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitMessagePrefix": "⬆️",
  "packageRules": [
    {
      "matchManagers": ["poetry"],
      "addLabels": ["python"]
    },
    {
      "matchManagers": ["poetry"],
      "matchDepTypes": ["dev"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["poetry"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["devcontainer"],
      "addLabels": ["python"],
      "rangeStrategy": "pin"
    },
    {
      "matchPackageNames": ["homeassistant", "pytest-homeassistant"],
      "groupName": "Home Assistant"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in workflow env values, marked with a renovate comment",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
